# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave "anon" (o "publishable"). NUNCA pongas acá la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app (para los links de recuperar contraseña). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dominio "técnico" para quienes se registran con celular (nunca recibe mails).
PHONE_EMAIL_DOMAIN=celular.comprasengrupo.app

# ── Avisos (etapa 5) ─────────────────────────────────────────────────────
# Clave service_role de Supabase (Project Settings → API). SOLO servidor, sin prefijo NEXT_PUBLIC_.
# Se usa para mandar avisos a otras personas, el cron de recordatorios y el reseteo de contraseñas.
SUPABASE_SERVICE_ROLE_KEY=

# Push: generá las claves con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https:// de contacto (lo piden los servicios de push)
VAPID_SUBJECT=mailto:admin@tudominio.com

# Email de respaldo (https://resend.com). Sin clave, simplemente no se mandan emails.
RESEND_API_KEY=
EMAIL_FROM=Compras en Grupo <avisos@tudominio.com>

# Secreto del cron de recordatorios (cualquier texto largo y al azar). Vercel lo manda solo.
CRON_SECRET=
